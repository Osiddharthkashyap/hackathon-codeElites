PORT=3000
NODE_ENV=development
# Use a dedicated MongoDB user with only readWrite access to this application's database.
MONGODB_URI=mongodb+srv://APP_USER:URL_ENCODED_PASSWORD@CLUSTER/learnflow?retryWrites=true&w=majority
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-random-64-plus-character-secret
AI_API_KEY=
# Keep this stable; changing it makes previously stored user keys unreadable.
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-random-32-plus-character-secret
