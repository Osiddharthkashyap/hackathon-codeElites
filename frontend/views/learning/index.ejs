<%- include("../partials/header", {
    pageTitle: "Continue Learning | LearnFlow AI"
}) %>

<main class="learning-page">

    <div class="learning-container">

        <!-- Top Navigation -->

        <div class="learning-topbar">

            <a
                href="/roadmap"
                class="learning-back"
            >
                ← Roadmap
            </a>

            <span class="learning-brand">
                LearnFlow AI
            </span>

        </div>


        <!-- Header -->

        <section class="learning-header">

            <div>

                <span class="onboarding-step-label">
                    PHASE 01 · WEB FOUNDATIONS
                </span>

                <h1>
                    Start your learning journey
                </h1>

                <p>
                    Complete each lesson at your own pace.
                    Your progress will be saved as you learn.
                </p>

            </div>


            <div class="learning-progress-card">

                <div class="learning-progress-header">

                    <span>
                        Overall progress
                    </span>

                    <strong>
                        0%
                    </strong>

                </div>

                <div class="learning-progress-track">

                    <div
                        class="learning-progress-bar"
                        style="width: 0%"
                    ></div>

                </div>

                <span>
                    0 of 6 lessons completed
                </span>

            </div>

        </section>


        <!-- Current Lesson -->

        <section class="current-lesson">

            <div class="current-lesson-content">

                <span class="lesson-status">
                    NEXT LESSON
                </span>

                <h2>
                    HTML Fundamentals
                </h2>

                <p>
                    Learn how HTML structures every webpage
                    and understand the building blocks of the web.
                </p>


                <div class="lesson-meta">

                    <span>
                        ◷ 30 min
                    </span>

                    <span>
                        ◉ Beginner
                    </span>

                    <span>
                        ⚡ Practical
                    </span>

                </div>


                <a
                    href="/learning/html-fundamentals"
                    class="start-lesson-button"
                >
                    Start Lesson
                    <span>→</span>
                </a>

            </div>


            <div class="current-lesson-visual">

                <div class="lesson-visual-card">

                    <span>
                        &lt;/&gt;
                    </span>

                </div>

            </div>

        </section>


        <!-- Lessons -->

        <section class="lesson-list-section">

            <div class="lesson-section-heading">

                <div>

                    <span class="onboarding-step-label">
                        PHASE 01
                    </span>

                    <h2>
                        Web Foundations
                    </h2>

                </div>

                <span>
                    6 lessons
                </span>

            </div>


            <div class="lesson-list">

                <!-- Lesson 1 -->

                <article class="lesson-list-item current">

                    <div class="lesson-number">
                        01
                    </div>

                    <div class="lesson-info">

                        <span>
                            LESSON 01
                        </span>

                        <h3>
                            HTML Fundamentals
                        </h3>

                        <p>
                            Learn the structure of modern webpages.
                        </p>

                    </div>

                    <div class="lesson-item-status">
                        <span>
                            Start
                        </span>
                        →
                    </div>

                </article>


                <!-- Lesson 2 -->

                <article class="lesson-list-item locked">

                    <div class="lesson-number">
                        02
                    </div>

                    <div class="lesson-info">

                        <span>
                            LESSON 02
                        </span>

                        <h3>
                            CSS Fundamentals
                        </h3>

                        <p>
                            Style your webpages and create layouts.
                        </p>

                    </div>

                    <div class="lesson-item-status">
                        🔒
                    </div>

                </article>


                <!-- Lesson 3 -->

                <article class="lesson-list-item locked">

                    <div class="lesson-number">
                        03
                    </div>

                    <div class="lesson-info">

                        <span>
                            LESSON 03
                        </span>

                        <h3>
                            Responsive Design
                        </h3>

                        <p>
                            Build interfaces that work on every device.
                        </p>

                    </div>

                    <div class="lesson-item-status">
                        🔒
                    </div>

                </article>


                <!-- Lesson 4 -->

                <article class="lesson-list-item locked">

                    <div class="lesson-number">
                        04
                    </div>

                    <div class="lesson-info">

                        <span>
                            LESSON 04
                        </span>

                        <h3>
                            CSS Layouts
                        </h3>

                        <p>
                            Master Flexbox and CSS Grid.
                        </p>

                    </div>

                    <div class="lesson-item-status">
                        🔒
                    </div>

                </article>


                <!-- Lesson 5 -->

                <article class="lesson-list-item locked">

                    <div class="lesson-number">
                        05
                    </div>

                    <div class="lesson-info">

                        <span>
                            LESSON 05
                        </span>

                        <h3>
                            Web Accessibility
                        </h3>

                        <p>
                            Create websites that everyone can use.
                        </p>

                    </div>

                    <div class="lesson-item-status">
                        🔒
                    </div>

                </article>


                <!-- Lesson 6 -->

                <article class="lesson-list-item locked">

                    <div class="lesson-number">
                        06
                    </div>

                    <div class="lesson-info">

                        <span>
                            LESSON 06
                        </span>

                        <h3>
                            Mini Project
                        </h3>

                        <p>
                            Build a simple webpage using what you've learned.
                        </p>

                    </div>

                    <div class="lesson-item-status">
                        🔒
                    </div>

                </article>

            </div>

        </section>

    </div>

</main>

<script src="/js/learning.js"></script>

<%- include("../partials/footer") %>
