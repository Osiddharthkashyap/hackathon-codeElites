<%- include("../partials/header", {
    pageTitle: "Register | LearnFlow AI"
}) %>

<main class="auth-page">

    <section class="auth-card">

        <a href="/" class="auth-brand">

            <span class="auth-brand-icon">
                ✦
            </span>

            <span class="auth-brand-text">
                LearnFlow AI
            </span>

        </a>


        <!-- Auth Tabs -->

        <div class="auth-tabs">

            <a
                href="/login"
                class="auth-tab"
            >
                Login
            </a>

            <a
                href="/register"
                class="auth-tab active"
            >
                Register
            </a>

        </div>


        <!-- Heading -->

        <div class="auth-heading">

            <h1>
                Create your account
            </h1>

            <p>
                Start building a learning journey designed for you.
            </p>

        </div>


        <!-- Register Form -->

        <form
            id="registerForm"
            class="auth-form"
        >

            <div class="form-group">

                <label for="name">
                    Full Name
                </label>

                <input
                    type="text"
                    id="name"
                    name="name"
                    placeholder="Alex Johnson"
                    required
                >

            </div>


            <div class="form-group">

                <label for="email">
                    Email
                </label>

                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="you@example.com"
                    required
                >

            </div>


            <div class="form-group">

                <label for="password">
                    Password
                </label>

                <div class="password-input-wrapper">

                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Create a strong password"
                        minlength="6"
                        required
                    >

                    <button
                        type="button"
                        class="password-toggle"
                        data-password-toggle
                    >
                        Show
                    </button>

                </div>

            </div>


            <div class="form-group">

                <label for="confirmPassword">
                    Confirm Password
                </label>

                <div class="password-input-wrapper">

                    <input
                        type="password"
                        id="confirmPassword"
                        name="confirmPassword"
                        placeholder="Confirm your password"
                        minlength="6"
                        required
                    >

                    <button
                        type="button"
                        class="password-toggle"
                        data-password-toggle
                    >
                        Show
                    </button>

                </div>

            </div>


            <label class="remember-me terms-checkbox">

                <input
                    type="checkbox"
                    required
                >

                <span>
                    I agree to the Terms and Privacy Policy
                </span>

            </label>


            <button
                type="submit"
                class="auth-submit-button"
            >
                Create Account
                <span>→</span>
            </button>

        </form>


        <p class="auth-switch-text">

            Already have an account?

            <a href="/login">
                Login
            </a>

        </p>

    </section>

</main>

<script src="/js/auth.js"></script>

<%- include("../partials/footer") %>