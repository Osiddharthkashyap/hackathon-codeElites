<!DOCTYPE html>
<html lang="en">
<%- include("../partials/header", { pageTitle: "Login | LearnFlow AI" }) %>

    <body>
        <main class="auth-page">

            <section class="auth-card">

                <a href="/" class="auth-brand">

                    <span class="auth-brand-icon">
                        ✦
                    </span>

                    <span class="auth-brand-text">
                        LearnFlow AI
                    </span>

                </a>


                <!-- Auth Tabs -->

                <div class="auth-tabs">

                    <a href="/login" class="auth-tab active">
                        Login
                    </a>

                    <a href="/register" class="auth-tab">
                        Register
                    </a>

                </div>


                <!-- Heading -->

                <div class="auth-heading">

                    <h1>
                        Welcome back
                    </h1>

                    <p>
                        Continue your personalized learning journey.
                    </p>

                </div>


                <% if (error) { %>
                    <div class="auth-divider" style="margin-top: 0; margin-bottom: 18px;">
                        <span>
                            <%= error %>
                        </span>
                    </div>
                    <% } %>


                        <!-- Login Form -->

                        <form id="loginForm" class="auth-form" action="/login" method="POST">

                            <div class="form-group">

                                <label for="email">
                                    Email
                                </label>

                                <input type="email" id="email" name="email" placeholder="you@example.com" required>

                            </div>


                            <div class="form-group">

                                <div class="form-label-row">

                                    <label for="password">
                                        Password
                                    </label>

                                    <a href="/login" class="forgot-password">
                                        Forgot password?
                                    </a>

                                </div>


                                <div class="password-input-wrapper">

                                    <input type="password" id="password" name="password"
                                        placeholder="Enter your password" required>

                                    <button type="button" class="password-toggle" data-password-toggle>
                                        Show
                                    </button>

                                </div>

                            </div>


                            <label class="remember-me">

                                <input type="checkbox" name="remember">

                                <span>
                                    Remember me
                                </span>

                            </label>


                            <button type="submit" class="auth-submit-button">
                                Login
                                <span>→</span>
                            </button>

                        </form>


                        <div class="auth-divider">

                            <span>
                                OR
                            </span>

                        </div>


                        <p class="auth-switch-text">

                            Don't have an account?

                            <a href="/register">
                                Register
                            </a>

                        </p>

            </section>

        </main>

        <script src="/js/auth.js"></script>

        <%- include("../partials/footer") %>
    </body>

</html>