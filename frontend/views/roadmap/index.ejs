<!DOCTYPE html>
<html lang="en">
<%- include("../partials/header", { pageTitle: "My Learning Roadmap | LearnFlow AI" }) %>
<body>

    <main class="roadmap-page">

        <div class="roadmap-container">

            <!-- Header -->

            <section class="roadmap-header">

                <div>

                    <span class="onboarding-step-label">
                        YOUR PERSONALIZED ROADMAP
                    </span>

                    <h1>
                        Your <%= onboarding.customGoal || onboarding.learningGoal || "Learning" %> Journey
                    </h1>

                    <p>
                        A learning path built around your current
                        level, goals, and available study time.
                    </p>

                </div>


                <div class="roadmap-header-actions">

                    <a href="/dashboard" class="roadmap-secondary-button">
                        Dashboard
                    </a>

                    <button class="roadmap-primary-button" id="startLearningButton">
                        Start Learning
                        <span>→</span>
                    </button>

                </div>

            </section>


            <!-- Overview -->

            <section class="roadmap-overview">

                <div class="roadmap-stat">

                    <span class="roadmap-stat-icon">
                        ◷
                    </span>

                    <div>

                        <strong>
                            8 weeks
                        </strong>

                        <span>
                            Estimated duration
                        </span>

                    </div>

                </div>


                <div class="roadmap-stat">

                    <span class="roadmap-stat-icon">
                        ◉
                    </span>

                    <div>

                        <strong>
                            <%= onboarding.experience || "Beginner" %>
                        </strong>

                        <span>
                            Current level
                        </span>

                    </div>

                </div>


                <div class="roadmap-stat">

                    <span class="roadmap-stat-icon">
                        ▣
                    </span>

                    <div>

                        <strong>
                            <%= onboarding.studyTime || "30–60 min" %>
                        </strong>

                        <span>
                            Daily commitment
                        </span>

                    </div>

                </div>


                <div class="roadmap-stat">

                    <span class="roadmap-stat-icon">
                        ✓
                    </span>

                    <div>

                        <strong>
                            6 milestones
                        </strong>

                        <span>
                            Learning milestones
                        </span>

                    </div>

                </div>

            </section>


            <!-- Roadmap -->

            <section class="roadmap-content">

                <div class="roadmap-section-heading">

                    <div>

                        <span class="onboarding-step-label">
                            YOUR LEARNING PATH
                        </span>

                        <h2>
                            From fundamentals to full stack
                        </h2>

                    </div>

                    <span class="roadmap-progress-label">
                        0% completed
                    </span>

                </div>


                <div class="roadmap-timeline">


                    <!-- Phase 1 -->

                    <article class="roadmap-phase active">

                        <div class="timeline-marker">

                            <span>
                                1
                            </span>

                        </div>


                        <div class="roadmap-phase-card">

                            <div class="phase-header">

                                <div>

                                    <span class="phase-label">
                                        PHASE 01
                                    </span>

                                    <h3>
                                        Web Foundations
                                    </h3>

                                </div>

                                <span class="phase-duration">
                                    1 week
                                </span>

                            </div>


                            <p>
                                Build a strong foundation in how the
                                web works and learn the core technologies
                                behind modern websites.
                            </p>


                            <div class="phase-topics">

                                <span>HTML</span>
                                <span>CSS</span>
                                <span>Web Basics</span>

                            </div>


                            <button class="phase-expand-button">
                                View topics
                                <span>↓</span>
                            </button>

                        </div>

                    </article>


                    <!-- Phase 2 -->

                    <article class="roadmap-phase">

                        <div class="timeline-marker">

                            <span>
                                2
                            </span>

                        </div>


                        <div class="roadmap-phase-card">

                            <div class="phase-header">

                                <div>

                                    <span class="phase-label">
                                        PHASE 02
                                    </span>

                                    <h3>
                                        JavaScript Fundamentals
                                    </h3>

                                </div>

                                <span class="phase-duration">
                                    2 weeks
                                </span>

                            </div>


                            <p>
                                Learn JavaScript fundamentals and start
                                building interactive web experiences.
                            </p>


                            <div class="phase-topics">

                                <span>JavaScript</span>
                                <span>DOM</span>
                                <span>ES6+</span>

                            </div>


                            <button class="phase-expand-button">
                                View topics
                                <span>↓</span>
                            </button>

                        </div>

                    </article>


                    <!-- Phase 3 -->

                    <article class="roadmap-phase">

                        <div class="timeline-marker">

                            <span>
                                3
                            </span>

                        </div>


                        <div class="roadmap-phase-card">

                            <div class="phase-header">

                                <div>

                                    <span class="phase-label">
                                        PHASE 03
                                    </span>

                                    <h3>
                                        Frontend Development
                                    </h3>

                                </div>

                                <span class="phase-duration">
                                    2 weeks
                                </span>

                            </div>


                            <p>
                                Move from JavaScript fundamentals to
                                building structured modern interfaces
                                and applications.
                            </p>


                            <div class="phase-topics">

                                <span>React</span>
                                <span>APIs</span>
                                <span>Components</span>

                            </div>


                            <button class="phase-expand-button">
                                View topics
                                <span>↓</span>
                            </button>

                        </div>

                    </article>


                    <!-- Phase 4 -->

                    <article class="roadmap-phase">

                        <div class="timeline-marker">

                            <span>
                                4
                            </span>

                        </div>


                        <div class="roadmap-phase-card">

                            <div class="phase-header">

                                <div>

                                    <span class="phase-label">
                                        PHASE 04
                                    </span>

                                    <h3>
                                        Backend Development
                                    </h3>

                                </div>

                                <span class="phase-duration">
                                    1 week
                                </span>

                            </div>


                            <p>
                                Learn how servers, APIs, databases and
                                authentication work together.
                            </p>


                            <div class="phase-topics">

                                <span>Node.js</span>
                                <span>Express</span>
                                <span>MongoDB</span>

                            </div>


                            <button class="phase-expand-button">
                                View topics
                                <span>↓</span>
                            </button>

                        </div>

                    </article>


                    <!-- Phase 5 -->

                    <article class="roadmap-phase">

                        <div class="timeline-marker">

                            <span>
                                5
                            </span>

                        </div>


                        <div class="roadmap-phase-card">

                            <div class="phase-header">

                                <div>

                                    <span class="phase-label">
                                        PHASE 05
                                    </span>

                                    <h3>
                                        Full Stack Integration
                                    </h3>

                                </div>

                                <span class="phase-duration">
                                    1 week
                                </span>

                            </div>


                            <p>
                                Connect frontend and backend technologies
                                to build complete applications.
                            </p>


                            <div class="phase-topics">

                                <span>REST APIs</span>
                                <span>Authentication</span>
                                <span>Deployment</span>

                            </div>


                            <button class="phase-expand-button">
                                View topics
                                <span>↓</span>
                            </button>

                        </div>

                    </article>


                    <!-- Phase 6 -->

                    <article class="roadmap-phase">

                        <div class="timeline-marker">

                            <span>
                                6
                            </span>

                        </div>


                        <div class="roadmap-phase-card">

                            <div class="phase-header">

                                <div>

                                    <span class="phase-label">
                                        PHASE 06
                                    </span>

                                    <h3>
                                        Capstone Project
                                    </h3>

                                </div>

                                <span class="phase-duration">
                                    1 week
                                </span>

                            </div>


                            <p>
                                Put everything together and build a
                                real-world full stack project.
                            </p>


                            <div class="phase-topics">

                                <span>Project</span>
                                <span>Git</span>
                                <span>Deployment</span>

                            </div>


                            <button class="phase-expand-button">
                                View topics
                                <span>↓</span>
                            </button>

                        </div>

                    </article>

                </div>

            </section>

        </div>

    </main>

    <script src="/js/roadmap.js"></script>

    <%- include("../partials/footer") %>
</body>
</html>
